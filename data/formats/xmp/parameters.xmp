<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 7.0-c000">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:crs="http://ns.adobe.com/camera-raw-settings/1.0/"
   crs:PresetType="Normal">
   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Studio</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Portraits</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Parameters>
    <rdf:Description
     crs:ProcessVersion="15.0"
     crs:WhiteBalance="Daylight"
     crs:Temperature="5500"
     crs:Tint="+5"
     crs:Exposure2012="0.5"
     crs:Contrast2012="10"
     crs:Vibrance="20"
     crs:Sharpness="40"
     crs:SharpenRadius="1.2"
     crs:SharpenDetail="30"
     crs:SharpenEdgeMasking="25"
     crs:LuminanceSmoothing="20"
     crs:ColorNoiseReduction="50"
     crs:LuminanceNoiseReductionDetail="60"
     crs:Texture="10"
     crs:Clarity2012="20"
     crs:Dehaze="30"
     crs:GrainAmount="30"
     crs:GrainSize="25"
     crs:GrainFrequency="70"
     crs:PostCropVignetteStyle="1"
     crs:PostCropVignetteAmount="-40"
     crs:PostCropVignetteMidpoint="60"
     crs:PostCropVignetteFeather="80"
     crs:PostCropVignetteRoundness="20"
     crs:PostCropVignetteHighlightContrast="40">
     <crs:MaskGroupBasedCorrections>
      <rdf:Seq>
       <rdf:li>
        <rdf:Description crs:What="Correction" crs:CorrectionName="Subject mask" crs:CorrectionAmount="0.6" crs:LocalExposure2012="0.4">
         <crs:CorrectionMasks>
          <rdf:Seq>
           <rdf:li crs:What="Mask/Image" crs:MaskName="Subject 1" crs:MaskSubType="1"/>
          </rdf:Seq>
         </crs:CorrectionMasks>
        </rdf:Description>
       </rdf:li>
      </rdf:Seq>
     </crs:MaskGroupBasedCorrections>
    </rdf:Description>
   </crs:Parameters>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
